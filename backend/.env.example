# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

PORT=8009
# Local fallback URL for generated files. Banner images used by the CMS come from GitHub, not from here.
PUBLIC_BASE_URL=

# VTEX
# Fallback when the request does not carry the account header.
VTEX_ACCOUNT=primegoods
# Override the commerce API host. "{account}" is replaced by the account name.
VTEX_API_HOST=

# CMS (Storefront > Content)
# Default branch for new landing pages when the user does not name one in the chat.
CMS_BRANCH=
# Defaults to the first store of the account.
CMS_STORE_ID=
CMS_CONTENT_TYPE=landingPage
# Used only when the store has no buildSettings.previewUrl.
CMS_PREVIEW_URL=
# Used only when the logged-in user's email cannot be resolved.
CMS_AUTHOR_EMAIL=
# GitHub repo that hosts banner images. It must be public so the CMS can load the raw URLs.
GITHUB_TOKEN=
GITHUB_REPO=owner/name
GITHUB_BRANCH=main
GITHUB_ASSETS_DIR=campaigns

# Local storage for conversations, attachments and generated banners.
DATA_DIR=./data
